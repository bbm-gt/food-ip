{
  "$defs": {
    "Origin": {
      "enum": [
        "explicit",
        "inferred",
        "synthesized"
      ],
      "title": "Origin",
      "type": "string"
    },
    "SourceRef": {
      "additionalProperties": false,
      "description": "Traceable source reference.",
      "properties": {
        "source_id": {
          "pattern": "^SRC\\d{4}$",
          "title": "Source Id",
          "type": "string"
        },
        "video_title": {
          "default": "",
          "title": "Video Title",
          "type": "string"
        },
        "start_time": {
          "default": "",
          "title": "Start Time",
          "type": "string"
        },
        "end_time": {
          "default": "",
          "title": "End Time",
          "type": "string"
        },
        "start_sec": {
          "default": 0.0,
          "title": "Start Sec",
          "type": "number"
        },
        "end_sec": {
          "default": 0.0,
          "title": "End Sec",
          "type": "number"
        }
      },
      "required": [
        "source_id"
      ],
      "title": "SourceRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Content expression format with planning/writing/shooting guidance.",
  "properties": {
    "format_id": {
      "description": "Deterministic hash ID (FID_...)",
      "title": "Format Id",
      "type": "string"
    },
    "display_id": {
      "default": "",
      "description": "Human-readable F000001",
      "title": "Display Id",
      "type": "string"
    },
    "name": {
      "maxLength": 40,
      "title": "Name",
      "type": "string"
    },
    "best_for": {
      "items": {
        "type": "string"
      },
      "title": "Best For",
      "type": "array"
    },
    "weak_for": {
      "items": {
        "type": "string"
      },
      "title": "Weak For",
      "type": "array"
    },
    "strengths": {
      "items": {
        "type": "string"
      },
      "title": "Strengths",
      "type": "array"
    },
    "risks": {
      "items": {
        "type": "string"
      },
      "title": "Risks",
      "type": "array"
    },
    "planning_guidance": {
      "default": "",
      "title": "Planning Guidance",
      "type": "string"
    },
    "writing_guidance": {
      "default": "",
      "title": "Writing Guidance",
      "type": "string"
    },
    "shooting_guidance": {
      "default": "",
      "title": "Shooting Guidance",
      "type": "string"
    },
    "related_question_ids": {
      "items": {
        "type": "string"
      },
      "title": "Related Question Ids",
      "type": "array"
    },
    "source": {
      "$ref": "#/$defs/SourceRef"
    },
    "confidence": {
      "default": 0.5,
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Confidence",
      "type": "number"
    },
    "origin": {
      "$ref": "#/$defs/Origin",
      "default": "inferred"
    },
    "evidence_segment_ids": {
      "items": {
        "type": "string"
      },
      "title": "Evidence Segment Ids",
      "type": "array"
    },
    "created_by_run_id": {
      "default": "",
      "title": "Created By Run Id",
      "type": "string"
    },
    "chunk_id": {
      "default": "",
      "title": "Chunk Id",
      "type": "string"
    }
  },
  "required": [
    "format_id",
    "name"
  ],
  "title": "CreativeFormat",
  "type": "object"
}