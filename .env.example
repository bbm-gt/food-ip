# 可执行文件可用命令名或绝对路径；能从 PATH 找到时无需修改。
CODEX_BIN=codex
PROJECTS_ROOT=runtime/projects
CORS_ORIGINS=http://localhost:5173
FRONTEND_DIST=frontend/dist

# Legacy AI 脚本生成。密钥只放在本机 .env，切勿提交到 Git。
DEEPSEEK_API_KEY=
AI_SCRIPT_BASE_URL=https://api.deepseek.com
AI_SCRIPT_MODEL=deepseek-v4-flash
# disabled 更快更省；需要更强推理时可改为 enabled。
AI_SCRIPT_THINKING=disabled
AI_SCRIPT_TIMEOUT_SECONDS=90

# Director Core 使用独立于 Legacy AI 脚本生成的 DeepSeek 配置；两者不能互相替代。
DIRECTOR_DEEPSEEK_API_KEY=
DIRECTOR_DB_PATH=runtime/director/director.sqlite3
DIRECTOR_CONTEXT_MAX_UNITS=100000
DIRECTOR_MAX_INTERNAL_STEPS=8
# Director stage output boundary: semantic_only is the product default; legacy is explicit fallback only.
DIRECTOR_STAGE_MODE=semantic_only
