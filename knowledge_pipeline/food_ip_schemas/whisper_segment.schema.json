{
  "additionalProperties": false,
  "description": "Raw segment from faster-whisper — NEVER modified after creation.\nTimestamps are machine-authoritative.",
  "properties": {
    "segment_id": {
      "description": "e.g. SRC0001-SEG0012",
      "title": "Segment Id",
      "type": "string"
    },
    "source_id": {
      "pattern": "^SRC\\d{4}$",
      "title": "Source Id",
      "type": "string"
    },
    "start_sec": {
      "minimum": 0.0,
      "title": "Start Sec",
      "type": "number"
    },
    "end_sec": {
      "minimum": 0.0,
      "title": "End Sec",
      "type": "number"
    },
    "raw_text": {
      "description": "Whisper original text, never modified",
      "title": "Raw Text",
      "type": "string"
    }
  },
  "required": [
    "segment_id",
    "source_id",
    "start_sec",
    "end_sec",
    "raw_text"
  ],
  "title": "WhisperSegment",
  "type": "object"
}